# Configuration TRIMED - Variables d'environnement

# URL de base de l'API Django
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Environnement (development, staging, production)
NODE_ENV=development

# Configuration de développement
REACT_APP_DEBUG=true

# Configuration de production (à utiliser en production)
# REACT_APP_API_BASE_URL=https://api.trimed.com/api
# NODE_ENV=production
# REACT_APP_DEBUG=false

# Configuration de staging (à utiliser pour les tests)
# REACT_APP_API_BASE_URL=https://staging-api.trimed.com/api
# NODE_ENV=staging
# REACT_APP_DEBUG=true

# Autres configurations possibles
# REACT_APP_SENTRY_DSN=your_sentry_dsn_here
# REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here