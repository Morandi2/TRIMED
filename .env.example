# Configuration TRIMED - Variables d'environnement
# Copiez ce fichier vers .env puis renseignez vos valeurs.

# URL de base de l'API Django (Backend)
VITE_API_BASE_URL=http://localhost:8000/api

# Environnement (development, staging, production)
# Ne pas définir NODE_ENV ici : Vite choisit le mode (développement avec `npm run dev`,
# production avec `npm run build`). NODE_ENV=development ferait livrer React en mode développement.

# Active les logs de configuration en développement
VITE_DEBUG=true

# --- Production (exemple) ---
# VITE_API_BASE_URL=https://trimedh-service.onrender.com/api
# VITE_DEBUG=false
